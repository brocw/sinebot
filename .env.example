DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here

# Bot owner — may run admin commands (/backfill, /config, /link-user) in any guild.
OWNER_ID=your-discord-user-id-here

# Only needed for `npm run deploy-commands -- --guild` during development.
GUILD_ID=your-server-id-here

# Legacy fallback: used only for guilds that have not run /config channel yet.
WORDLE_CHANNEL_ID=your-wordle-channel-id-here
